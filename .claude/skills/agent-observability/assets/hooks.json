{
  "_comment": "Reference template — merge the \"hooks\" key into your project's .claude/settings.json (Claude Code does not read a standalone hooks.json file).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/skills/agent-observability/assets/hooks/pre_tool_use.sh\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/skills/agent-observability/assets/hooks/post_tool_use.sh\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/skills/agent-observability/assets/hooks/stop.sh\"",
            "timeout": 15000
          }
        ]
      }
    ]
  }
}
